{
  "info": {
    "name": "Tienda - Microservicios (Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registrar usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gateway}}/api/usuarios/registrar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Juan\",\n  \"apellidos\": \"Pérez\",\n  \"email\": \"juan@test.com\",\n  \"contrasena\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "2. Login (obtener token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.token) { pm.collectionVariables.set('token', data.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{gateway}}/api/usuarios/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan@test.com\",\n  \"contrasena\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "3. Ver perfil (con token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/api/usuarios/perfil"
      }
    },
    {
      "name": "4. Listar usuarios registrados (con token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/api/usuarios"
      }
    },
    {
      "name": "5. Listar productos (con token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/api/productos"
      }
    },
    {
      "name": "6. Listar productos SIN token (debe dar 401)",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/api/productos"
      }
    },
    {
      "name": "7. Comprar producto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{gateway}}/api/compras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"producto_id\": 1,\n  \"cantidad\": 2\n}"
        }
      }
    },
    {
      "name": "8. Ver mis compras",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/api/compras"
      }
    }
  ]
}
